# -----------------------------------------------------------------------------
# 2026-09-01 (scondam): AHU:DPS:DisableStatus migrated from raw alias to the
# validated-bit chain (see pnzValidBit.substitutions). Reason: the raw I019
# alias inherited generic OFF/ON enum strings, so panels showed "ON/OFF"
# instead of "Enabled/Disabled". The validated-bit template sets
# ZNAM=Enabled/ONAM=Disabled with OSV=MINOR, matching Oxigraf Air:KeyStatus.
# This mirrors the earlier AHU:FaultStatus migration (see note ~line 141).
# Do NOT re-enable this alias while the substitutions line exists (duplicate).
#alias("ODM:$(SECTOR):I019", "ODM:$(SECTOR):100:AHU:DPS:DisableStatus") # PLC o19 S10_AHU_DPS_Disable_Sts
# -----------------------------------------------------------------------------
#alias("ODM:$(SECTOR):I019", "ODM:$(SECTOR):100:AHU:DPS:DisableStatus") # PLC o19 S10_AHU_DPS_Disable_Sts

alias("ODM:$(SECTOR):I020", "ODM:$(SECTOR):100:Air:DC:FaultStatus")    # PLC o20 Oxigraf_DC_OK_Sts
