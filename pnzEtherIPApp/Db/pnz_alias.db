#--------------------------------------------------------------
# Control / annunciation aliases (added with ARM + comm-loss work)
#--------------------------------------------------------------
alias("ODM:$(SECTOR):ARM:CMD",           "ODM:$(SECTOR):CMD:Arm")
alias("ODM:$(SECTOR):COMM:DROP:LATCH",   "ODM:$(SECTOR):CMD:CommDropAlarm")
#==============================================================
# IF BENCH TEST SHOWS BIT-REVERSAL within each byte:
#   PLC o[N] maps to IOC bit [8*(N/8) + 7-(N%8)] instead of [N].
#   e.g. o0->I007, o1->I006, ... o7->I000; o8->I015 ... etc.
#   Remap the I### target on each alias line accordingly.
# (The right-hand human name stays; only the I### index changes.)
#==============================================================
