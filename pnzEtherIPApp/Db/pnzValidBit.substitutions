file "db/pnzValidBit.template" {
    pattern
    { PV                                    RAW                       VNAME                     DESC                                  ZNAM          ONAM      ZSV        OSV        }

    # ================================================================
    #  B34 (-> LI09) validated bits, cloned from PRODUCTION LI07.
    #  Names/severities/enum-strings verified against LI07 on
    #  2026-08-28 (caget dump).  Safety-approved polarity+severity.
    #
    #  DEFERRED (need raw-bit confirmation for LI09):
    #    - UPS DC (101:DC:UpsFaultStatus / 101:DC:UpsFaultLatched)
    #    - Power Fault SUM (100:Pwr:FaultLatched)
    #  EXCLUDED for LI09 (LI07-only): 101/102:Cell:*, 100:AC:*,
    #    100:Ahu:AlarmByp.
    # ================================================================

    # ---- Alarm summaries / statuses (T->O) --------------------------------
    { "ODM:$(SECTOR):100:ACRAlarmStatus"    "ODM:$(SECTOR):I064"      "ODM:$(SECTOR):I064"      "ODH $(SECTOR) Alarm"                 "NO_ALARM"    "ALARM"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):100:L1AlarmSum"        "ODM:$(SECTOR):I065"      "ODM:$(SECTOR):I065"      "L1 Alarm from Supervisor, <19.5% O2" "NO_ALARM"    "ALARM"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):100:L1AlarmStatus"     "ODM:$(SECTOR):I067"      "ODM:$(SECTOR):I067"      "L1 Alarm from Pilz, <19.5% O2"       "NO_ALARM"    "ALARM"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):100:L2AlarmSum"        "ODM:$(SECTOR):I066"      "ODM:$(SECTOR):I066"      "L2 Alarm from Supervisor <18% O2"    "NO_ALARM"    "ALARM"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):100:L2AlarmStatus"     "ODM:$(SECTOR):I068"      "ODM:$(SECTOR):I068"      "L2 Alarm from Pilz, <18% O2"         "NO_ALARM"    "ALARM"   "NO_ALARM" "MAJOR"    }

    # ---- Mute / Strobe / Horn / Key ---------------------------------------
    { "ODM:$(SECTOR):100:AlarmMuteStatus"   "ODM:$(SECTOR):I010"      "ODM:$(SECTOR):I010"      "Alarm Mute Sts"                      "Normal"      "Mute"    "NO_ALARM" "MINOR"    }
    { "ODM:$(SECTOR):100:StrobeStatus"      "ODM:$(SECTOR):I011"      "ODM:$(SECTOR):I011"      "Strobe Sts"                          "Off"         "On"      "NO_ALARM" "MAJOR" }
    { "ODM:$(SECTOR):100:HornStatus"        "ODM:$(SECTOR):I012"      "ODM:$(SECTOR):I012"      "Horn Sts"                            "Off"         "On"      "NO_ALARM" "MAJOR" }
    { "ODM:$(SECTOR):100:Air:KeyStatus"     "ODM:$(SECTOR):I013"      "ODM:$(SECTOR):I013"      "Oxigraf1 Disable Key Sts"            "Enabled"     "Disabled" "NO_ALARM" "MINOR"   }

    # ---- Oxigraf channels (Real=live).  LI07: Ok/Fault, OSV=MAJOR ----------
    { "ODM:$(SECTOR):101:Air:FaultStatus"   "ODM:$(SECTOR):I000"      "ODM:$(SECTOR):I000"      "Air Sample Oxigraf1 Ch0 Real"        "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):101:Air:FaultLatched"  "ODM:$(SECTOR):I001"      "ODM:$(SECTOR):I001"      "Air Sample Oxigraf1 Ch0 Latch"       "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):102:Air:FaultStatus"   "ODM:$(SECTOR):I002"      "ODM:$(SECTOR):I002"      "Air Sample Oxigraf1 Ch1 Real"        "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):102:Air:FaultLatched"  "ODM:$(SECTOR):I003"      "ODM:$(SECTOR):I003"      "Air Sample Oxigraf1 Ch1 Latch"       "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):103:Air:FaultStatus"   "ODM:$(SECTOR):I004"      "ODM:$(SECTOR):I004"      "Air Sample Oxigraf1 Ch2 Real"        "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):103:Air:FaultLatched"  "ODM:$(SECTOR):I005"      "ODM:$(SECTOR):I005"      "Air Sample Oxigraf1 Ch2 Latch"       "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):104:Air:FaultStatus"   "ODM:$(SECTOR):I006"      "ODM:$(SECTOR):I006"      "Air Sample Oxigraf1 Ch3 Real"        "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):104:Air:FaultLatched"  "ODM:$(SECTOR):I007"      "ODM:$(SECTOR):I007"      "Air Sample Oxigraf1 Ch3 Latch"       "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }

    # ---- SYS OK (LI07: Ok/Fault, OSV=MAJOR) -------------------------------
    { "ODM:$(SECTOR):100:SysReady"          "ODM:$(SECTOR):I008"      "ODM:$(SECTOR):I008"      "Oxigraf1 SYS OK Real"                "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }
    { "ODM:$(SECTOR):100:SysReadyLatched"   "ODM:$(SECTOR):I009"      "ODM:$(SECTOR):I009"      "Oxigraf1 SYS OK Latch"               "Ok"          "Fault"   "NO_ALARM" "MAJOR"    }

    # ---- Area of Refuge (LI07 polarity: Fault/Ok, ZSV=MAJOR) --------------
    { "ODM:$(SECTOR):100:AOR:FaultStatus"   "ODM:$(SECTOR):I021"      "ODM:$(SECTOR):I021"      "Area Of Refuge Sw OK"                "Fault"       "Ok"      "MAJOR"    "NO_ALARM" }
    { "ODM:$(SECTOR):100:AOR:AlarmStatus"   "ODM:$(SECTOR):I069"      "ODM:$(SECTOR):I069"      "AOR DP Switch fault & No PPS Clear"  "Normal"      "Alert"   "NO_ALARM" "MAJOR"    }

    # ---- Air Handling Unit (LI07: Fault/Ok, ZSV=MAJOR) --------------------
    { "ODM:$(SECTOR):100:AHU:FaultStatus"   "ODM:$(SECTOR):I022"      "ODM:$(SECTOR):I022"      "Air Handling Unit Sw OK"             "Fault"       "Ok"      "MAJOR"    "NO_ALARM" }
    { "ODM:$(SECTOR):100:AHU:FaultLatched"  "ODM:$(SECTOR):I103"      "ODM:$(SECTOR):I103"      "Air Handling Unit Latch"             "Not_Latched" "Latched" "NO_ALARM" "MAJOR" }
    { "ODM:$(SECTOR):100:AHU:DPS:DisableStatus"  "ODM:$(SECTOR):I019" "ODM:$(SECTOR):I019"      "AHU DPS Disable Sts"                 "Enabled"     "Disabled" "NO_ALARM"  "MINOR" }
    
    # ---- Power supplies DC.  LI07: FaultStatus=Real(live), FaultLatched=latch
    #  *** TODO: VERIFY which raw bit is live vs latch on B34.  LI07 DESC
    #      shows FaultStatus="...DC OK Real"(live) / FaultLatched="...DC OK".
    #      Current B34 has I016/I017 (live) + I098/I099 ("Real"). Mapping
    #      below assumes I016/I017 = FaultStatus(live), I098/I099 = latch.
    #      CONFIRM with Safety before production. ***
    { "ODM:$(SECTOR):101:DC:FaultLatched"    "ODM:$(SECTOR):I016"      "ODM:$(SECTOR):I016"      "Power Supply 1 DC OK Real"           "Fault"       "Ok"      "MAJOR"    "NO_ALARM" }
    { "ODM:$(SECTOR):101:DC:FaultStatus"     "ODM:$(SECTOR):I098"      "ODM:$(SECTOR):I098"      "Power Supply 1 DC OK"                "Fault"       "Ok"      "MAJOR"    "NO_ALARM" }
    { "ODM:$(SECTOR):102:DC:FaultLatched"    "ODM:$(SECTOR):I017"      "ODM:$(SECTOR):I017"      "Power Supply 2 DC OK Real"           "Fault"       "Ok"      "MAJOR"    "NO_ALARM" }
    { "ODM:$(SECTOR):102:DC:FaultStatus"     "ODM:$(SECTOR):I099"      "ODM:$(SECTOR):I099"      "Power Supply 2 DC OK"                "Fault"       "Ok"      "MAJOR"    "NO_ALARM" }

    # ---- Supervisor signals ----------------------------------------------
    { "ODM:$(SECTOR):100:PpsClear"          "ODM:$(SECTOR):I071"      "ODM:$(SECTOR):I071"      "PPS Clear"                           "Not_Clear"   "Clear"   "NO_ALARM" "MINOR" }
    { "PLC:$(SECTOR):OD01:TestMode"         "ODM:$(SECTOR):I070"      "ODM:$(SECTOR):I070"      "PLC in Test mode from Supervisor"    "Normal"      "Test"    "NO_ALARM" "MINOR"    }
    { "PLC:$(SECTOR):OD01:HeartBeat"        "ODM:$(SECTOR):I023"      "ODM:$(SECTOR):I023"      "Heart Beat"                          "Off"         "On"      "NO_ALARM" "NO_ALARM" }

    { "ODM:$(SECTOR):100:GreenLightON"      "ODM:$(SECTOR):I024"      "ODM:$(SECTOR):I024"      "ODH OK to Enter (Green Light)"       "Off"         "On"      "MAJOR"    "NO_ALARM" }
    # ================================================================
    #  DEFERRED - uncomment & assign raw bits once LI09 hardware known:
    #
    #  UPS DC (LI07 uses module 101, Fault/Ok, ZSV=MAJOR):
      { "ODM:$(SECTOR):101:DC:UpsFaultStatus"  "ODM:$(SECTOR):I100"  "ODM:$(SECTOR):I100"  "UPS1 DC OK Real"  "Fault" "Ok" "MAJOR" "NO_ALARM" }
      { "ODM:$(SECTOR):101:DC:UpsFaultLatched" "ODM:$(SECTOR):I018"  "ODM:$(SECTOR):I018"  "UPS1 DC OK"       "Fault" "Ok" "MAJOR" "NO_ALARM" }
    #
    #  Power Fault SUM latch:
      { "ODM:$(SECTOR):100:Pwr:FaultLatched"   "ODM:$(SECTOR):I072"  "ODM:$(SECTOR):I072"  "Power Fault Latch" "Not_Latched" "Latched" "NO_ALARM" "MAJOR" }
    # ================================================================
}
