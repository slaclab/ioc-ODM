record(waveform, "ODM:$(SECTOR):INPUT:RAW:HEX") {
    field(DESC, "Input image as hex string")
    field(DTYP, "PNZ EtherIP")        
    field(INP,  "@RAWINHEX")
    field(FTVL, "CHAR")
    field(NELM, "100")
    field(SCAN, "I/O Intr")
}

record(waveform, "ODM:$(SECTOR):OUTPUT:RAW:HEX") {
    field(DESC, "Output image (commanded) as hex string")
    field(DTYP, "PNZ EtherIP")
    field(INP,  "@RAWOUTHEX")
    field(FTVL, "CHAR")
    field(NELM, "100")
    field(SCAN, "1 second")
}

#--------------------------------------------------------------
# PLC diagnostics (explicit messaging). Slow scan; static except DevStatus.
# DIAG:VALID goes 1 once Identity read succeeds.
#--------------------------------------------------------------
record(calc, "ODM:$(SECTOR):DIAG:VALID") {
    field(DESC, "Identity read OK")
    field(INPA, "ODM:$(SECTOR):IDCODE CP")
    field(CALC, "A > 0")
    field(HIGH, "0")          # A>0 -> 1 (valid); =0 -> 0 (no data)
}

record(calc, "ODM:$(SECTOR):FWREV") {
    field(DESC, "Firmware rev (maj.min as number)")
    field(INPA, "ODM:$(SECTOR):IDREVMAJ CP")
    field(INPB, "ODM:$(SECTOR):IDREVMIN CP")
    field(CALC, "A + B/10")
    field(PREC, "1")
}

#--------------------------------------------------------------
# PLC / module Identity (CIP Identity Object 0x01) - read once via
# explicit messaging at connect. Static. VERIFIED on bench.
#--------------------------------------------------------------

record(longin, "ODM:$(SECTOR):IDVENDOR") { field(DTYP,"PNZ EtherIP") field(INP,"@IDVENDOR") field(SCAN,"5 second") field(DESC,"CIP Vendor ID (181=Pilz)") }
record(longin, "ODM:$(SECTOR):IDTYPE")   { field(DTYP,"PNZ EtherIP") field(INP,"@IDTYPE")   field(SCAN,"5 second") field(DESC,"CIP Device Type") }
record(longin, "ODM:$(SECTOR):IDCODE")   { field(DTYP,"PNZ EtherIP") field(INP,"@IDCODE")   field(SCAN,"5 second") field(DESC,"CIP Product Code (85)") }
record(longin, "ODM:$(SECTOR):IDREVMAJ") { field(DTYP,"PNZ EtherIP") field(INP,"@IDREVMAJ") field(SCAN,"5 second") field(DESC,"Firmware rev major") }
record(longin, "ODM:$(SECTOR):IDREVMIN") { field(DTYP,"PNZ EtherIP") field(INP,"@IDREVMIN") field(SCAN,"5 second") field(DESC,"Firmware rev minor") }
record(longin, "ODM:$(SECTOR):IDSTATUS") { field(DTYP,"PNZ EtherIP") field(INP,"@IDSTATUS") field(SCAN,"5 second") field(DESC,"CIP Status word") }
record(longin, "ODM:$(SECTOR):IDSERIAL") { field(DTYP,"PNZ EtherIP") field(INP,"@IDSERIAL") field(SCAN,"5 second") field(DESC,"Serial number") }

record(waveform, "ODM:$(SECTOR):IDNAME") {
    field(DESC, "CIP Product Name")
    field(DTYP, "PNZ EtherIP")
    field(INP,  "@IDNAME")
    field(FTVL, "CHAR")
    field(NELM, "64")
    field(SCAN, "5 second")
}

#--------------------------------------------------------------
# Base-unit LED byte (cyclic input byte 16).
# BENCH-CONFIRMED: byte = 0xF0 when PLC RUNNING, 0xA8 when STOPPED.
# b6 & b4 = Run indicators (on when running, off when stopped).
# NOTE: LED byte does NOT change on faults (bench finding) -> this is a
#       RUN/STOP indicator only, NOT a fault/diagnostic source.
#--------------------------------------------------------------
record(longin, "ODM:$(SECTOR):PLC:LED") {
    field(DESC, "Base unit LED byte (raw)")
    field(DTYP, "PNZ EtherIP")
    field(INP,  "@LED")
    field(SCAN, "1 second")
    field(FLNK, "ODM:$(SECTOR):PLC:Running_calc")
}

# Per-bit breakout for engineering visibility (meanings partial).
record(mbbiDirect, "ODM:$(SECTOR):PLC:LED:Bits") {
    field(DESC, "LED byte per-bit")
    field(INP,  "ODM:$(SECTOR):PLC:LED CP")
    field(NOBT, "8")
}

# PLC Running: conservative decode -- both Run bits (b6 AND b4) set.
# 0xF0 running -> b6=1,b4=1 -> RUNNING; 0xA8 stopped -> b6=0,b4=0 -> STOPPED.
record(calc, "ODM:$(SECTOR):PLC:Running_calc") {
    field(DESC, "PLC running (b6 AND b4)")
    field(INPA, "ODM:$(SECTOR):PLC:LED")
    field(CALC, "((A & 0x40) && (A & 0x10)) ? 1 : 0")
    field(FLNK, "ODM:$(SECTOR):PLC:Running")
}
record(bi, "ODM:$(SECTOR):PLC:Running") {
    field(DESC, "Safety PLC run state")
    field(INP,  "ODM:$(SECTOR):PLC:Running_calc")
    field(ZNAM, "STOPPED")
    field(ONAM, "RUNNING")
    field(ZSV,  "MAJOR")
    field(OSV,  "NO_ALARM")
}

# Power indicator. b7 and b5 stayed ON in both observed states -> one is
# supply-present. We use b7. *** ASSUMED: b7=Power (NOT isolated on bench).
# Also note: read from cyclic input, so this is only meaningful while the
# connection is live; CONNECTED/COMM:STS is the truer "unit alive" signal.
record(calc, "ODM:$(SECTOR):PLC:Power_calc") {
    field(DESC, "Power present (b7) - ASSUMED bit")
    field(INPA, "ODM:$(SECTOR):PLC:LED CP")
    field(CALC, "(A & 0x80) ? 1 : 0")
    field(FLNK, "ODM:$(SECTOR):PLC:Power")
}
record(bi, "ODM:$(SECTOR):PLC:Power") {
    field(DESC, "Base unit power (b7, assumed)")
    field(INP,  "ODM:$(SECTOR):PLC:Power_calc")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(ZSV,  "MINOR")
}

#--------------------------------------------------------------
# Synthetic PLC status -- single-enum device health, built ENTIRELY from
# LIVE signals (NOT the Assembly-5 DevStatus, which this device does not
# serve via explicit Get -> 0x16). This replaces the dead DEVSTATUS mbbi.
#
# Priority (highest first):
#   DISCONNECTED : no Class-1 connection (CONNECTED=0)          -> MAJOR
#   COMM FAULT   : connected now, but an unacked drop occurred  -> MAJOR
#   STOPPED      : connected, no drop, but PLC not running       -> MAJOR
#   RUNNING      : connected, no unacked drop, PLC running        -> OK
#
# Inputs (all live):
#   A = CONNECTED          (1=connected)
#   B = PLC:Running_calc   (1=running: LED b6 & b4)
#   C = COMM:DROP:LATCH    (1=unacked drop since last ACK)
#--------------------------------------------------------------
record(calc, "ODM:$(SECTOR):PLC:STATUS_calc") {
    field(DESC, "Synthetic PLC status (live)")
    field(INPA, "ODM:$(SECTOR):CONNECTED CP MS")
    field(INPB, "ODM:$(SECTOR):PLC:Running_calc CP MS")
    field(INPC, "ODM:$(SECTOR):COMM:DROP:LATCH CP MS")
    # 0=Disconnected, 1=Comm Fault, 2=Stopped, 3=Running
    field(CALC, "A==0 ? 0 : (C ? 1 : (B ? 3 : 2))")
    field(FLNK, "ODM:$(SECTOR):PLC:STATUS")
}

record(mbbi, "ODM:$(SECTOR):PLC:STATUS") {
    field(DESC, "PLC status (from live signals)")
    field(INP,  "ODM:$(SECTOR):PLC:STATUS_calc")
    field(ZRVL, "0") field(ZRST, "DISCONNECTED") field(ZRSV, "MAJOR")
    field(ONVL, "1") field(ONST, "COMM FAULT")   field(ONSV, "MAJOR")
    field(TWVL, "2") field(TWST, "STOPPED")      field(TWSV, "MAJOR")
    field(THVL, "3") field(THST, "RUNNING")      field(THSV, "NO_ALARM")
    field(UNSV, "MAJOR")
}

#--------------------------------------------------------------
#--------------------------------------------------------------
# Comm-loss diagnostics (scondam: drop-count + timestamp)
# DTYP MUST be "PNZ EtherIP" (same as every other driver record);
# "PnzLi"/"PnzWf" are NOT registered -> silently fall back to Soft
# Channel and the @token link is dropped (record reads empty/0).
#--------------------------------------------------------------

record(longin, "ODM:$(SECTOR):COMM:DropCount") {
    field(DESC, "EtherNet/IP disruption count")
    field(DTYP, "PNZ EtherIP")
    field(INP,  "@DROPCOUNT")
    field(SCAN, "1 second")
    field(HIGH, "1")
    field(HSV,  "MINOR")
}

# Timestamp of the most recent disruption, as a native DBF_STRING.
# EDM Text Monitor renders a stringin as text directly (no CHAR-array quirks).
# Shows "no disruption since IOC start" until the first drop.

record(stringin, "ODM:$(SECTOR):COMM:LastDropTime") {
    field(DESC, "Time of last EtherNet/IP disruption")
    field(DTYP, "PNZ EtherIP")
    field(INP,  "@LASTDROPTIME")
    field(SCAN, "I/O Intr")
    field(PINI, "YES")
}
