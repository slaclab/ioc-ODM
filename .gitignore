# ===== EPICS build outputs (repo-root only; anchored so they don't match
#       same-named dirs inside vendored deps like EIPScanner) =====
/O.*
/autosave/
/bin/
/db/
/dbd/
/include/
/lib/
/envPaths
/RELEASE_SITE

# Per-app generated build dirs (any depth) - keep UNanchored
O.*

# ===== EIPScanner (vendored source; BUILD FROM SOURCE, artifacts NOT committed) =====
# Build via ./build.sh (Philosophy 2). build/ and install/ are GENERATED
# (abs paths, machine caches, and a .a that can drift from source). Committing
# them caused a stale Path-A-less library to nearly ship to production (2026-09).
/EIPScanner/build/
/EIPScanner/install/

# ===== misc =====
*.bak
*~
*.swp
archive/
info*.req

.cproject
.project
.settings/
tmp/

# Generated per-IOC boot files (created by build.sh via convertRelease.pl)
/iocBoot/*/envPaths

# Manual pre-change backups
*.pre_optionf_step4

# EIPScanner upstream extras not needed for library build
/EIPScanner/.travis.yml
/EIPScanner/Dockerfile
/EIPScanner/docker-compose.yml
/EIPScanner/docker/
/EIPScanner/docs/
/EIPScanner/examples/
/EIPScanner/test/
