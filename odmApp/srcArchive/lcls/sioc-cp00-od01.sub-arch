file MO2i.tpl-arch
{
pattern	{ PRIM, LOCA, UNIT }
		{ ODM,  CR1,  1,   }
		{ ODM,  CR1,  2,   }
		{ ODM,  CR0,  1,   }
		{ ODM,  CR0,  2,   }
		{ ODM,  CR2,  1,   }
		{ ODM,  CR2,  2,   }
}

file odm_pilz_diags.tpl-arch
{
pattern   { P       ,  PLC }
          { PLC:CP00, OD01 }
}

file archive_SR.tpl-arch
{
pattern   { IOC            }
          { SIOC:CP00:OD01 }
}

file archive_iocAdmin.tpl-arch
{
    pattern { IOC            }
            { SIOC:CP00:OD01 }
}

