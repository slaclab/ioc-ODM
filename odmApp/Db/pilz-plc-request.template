record(longout, "$(dtype):$(area):$(position):REQ_TABLE") {
field(DESC, "$(description)")
field(VAL, "$(tabval=9)")
field(OUT, "$(dtype):$(area):$(position):REQ_TABLE_OUT PP")
field(HOPR, "128")
field(LOPR, "0")
field(PINI, "YES")
	info(autosaveFields, "VAL")
}

# All the data we're interested in is: Tables 1 and 9, segment 1
# We only need table 1 once for check sums that don't change, so
# read it for a short time during startup, then switch to table 9.
record(calcout, "$(dtype):$(area):$(position):TABLE_CYCLER")
{
	field( OUT, "$(dtype):$(area):$(position):REQ_TABLE PP")
	field( CALC, "A:=(A+1)%360;A=10?1:9")
	field( INPA, "0")
	field( SCAN, "5 second")
}

# Records for disabling PVs when their reqest table isn't active
record(calc, "$(dtype):$(area):$(position):TABLE_9_SEG_1")
{
  field( INPA, "$(dtype):$(area):$(position):REQ_TABLE CP")
  field( INPB, "$(dtype):$(area):$(position):REQ_SEG CP")
  field( INPC, "$(dtype):$(area):$(position):REQ_TABLE_IN CP")
  field( INPD, "$(dtype):$(area):$(position):REQ_SEG_IN CP")
  field(CALC, "A=9 & B=1 & C=9 & D=1")
}

record(calc, "$(dtype):$(area):$(position):TABLE_1_SEG_1")
{
  field( INPA, "$(dtype):$(area):$(position):REQ_TABLE CP")
  field( INPB, "$(dtype):$(area):$(position):REQ_SEG CP")
  field( INPC, "$(dtype):$(area):$(position):REQ_TABLE_IN CP")
  field( INPD, "$(dtype):$(area):$(position):REQ_SEG_IN CP")
  field(CALC, "A=1 & B=1 & C=1 & D=1")
}

# The target PVs don't use the data, but this has 8 forward links,
# the number we need, while the fanout record only has 6.
record(dfanout, "$(dtype):$(area):$(position):REQ_TABLE_OUT") {
field(OUTA, "$(dtype):$(area):$(position):REQ_TABLE_BIT0_CALC.A PP")
field(OUTB, "$(dtype):$(area):$(position):REQ_TABLE_BIT1_CALC.A PP")
field(OUTC, "$(dtype):$(area):$(position):REQ_TABLE_BIT2_CALC.A PP")
field(OUTD, "$(dtype):$(area):$(position):REQ_TABLE_BIT3_CALC.A PP")
field(OUTE, "$(dtype):$(area):$(position):REQ_TABLE_BIT4_CALC.A PP")
field(OUTF, "$(dtype):$(area):$(position):REQ_TABLE_BIT5_CALC.A PP")
field(OUTG, "$(dtype):$(area):$(position):REQ_TABLE_BIT6_CALC.A PP")
field(OUTH, "$(dtype):$(area):$(position):REQ_TABLE_BIT7_CALC.A PP")
field(SDIS, "$(dtype):$(area):$(position):REQ_TABLE_IN.PACT")
}

record(calcout, "$(dtype):$(area):$(position):REQ_TABLE_BIT0_CALC") {
field(INPA, "$(dtype):$(area):$(position):REQ_TABLE_OUT")
field(CALC, "A&1")
field(OUT, "$(dtype):$(area):$(position):REQ_TABLE_BIT0 PP")
