	field(SCAN, "I/O Intr")
	field(DTYP, "asynUInt32Digital")
	field(INP,  "@asynMask($(port_rd), 45, 1, 1)")
	field(ZNAM, "Off")
	field(ONAM, "On")
	field(ZSV,  "NO_ALARM")
	field(OSV,  "NO_ALARM")
  info(autosaveFields_pass0, "SEVR")
}

