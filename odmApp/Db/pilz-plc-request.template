record(longout, "$(dtype):$(areapos):REQ_TABLE") {
	field(DESC, "Table to read/write")
	field(VAL, "$(tabval=9)")
	field(OUT, "$(dtype):$(areapos):REQ_TABLE_OUT PP")
	field(HOPR, "128")
	field(LOPR, "0")
	field(PINI, "YES")
	info(autosaveFields, "VAL")
}

# All the data we're interested in is: Tables 1 and 9, segment 1
# We only need table 1 once for check sums that don't change, so
# read it for a short time during startup, then switch to table 9.
record(calcout, "$(dtype):$(areapos):TABLE_CYCLER")
{
	field( OUT, "$(dtype):$(areapos):REQ_TABLE PP")
	field( CALC, "A:=(A+1)%360;A=10?1:9")
	field( INPA, "0")
	field( SCAN, "5 second")
}

record(calcout, "$(dtype):$(areapos):SEG_CYCLER")
{
	field( OUT, "$(dtype):$(areapos):REQ_SEG PP")
	field( CALC, "1")
	field( INPA, "0")
	field( SCAN, "10 second")
}

# Records for disabling PVs when their reqest table isn't active
record(calc, "$(dtype):$(areapos):TABLE_9_SEG_1")
{
	field( INPA, "$(dtype):$(areapos):REQ_TABLE CP")
	field( INPB, "$(dtype):$(areapos):REQ_SEG CP")
	field( INPC, "$(dtype):$(areapos):REQ_TABLE_IN CP")
	field( INPD, "$(dtype):$(areapos):REQ_SEG_IN CP")
	field(CALC, "A=9 & B=1 & C=9 & D=1")
}

record(calc, "$(dtype):$(areapos):TABLE_1_SEG_1")
{
	field( INPA, "$(dtype):$(areapos):REQ_TABLE CP")
	field( INPB, "$(dtype):$(areapos):REQ_SEG CP")
	field( INPC, "$(dtype):$(areapos):REQ_TABLE_IN CP")
	field( INPD, "$(dtype):$(areapos):REQ_SEG_IN CP")
	field(CALC, "A=1 & B=1 & C=1 & D=1")
}

