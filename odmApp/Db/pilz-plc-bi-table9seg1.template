record(bi, "$(dtype):$(areapos):$(port)b$(bit)") {
  field(DESC, "Port $(port) bit $(bit)")
  field(SCAN, "I/O Intr")
  field(DTYP, "asynUInt32Digital")
  field(INP,  "@asynMask($(port), $(bit), 1, 1)")
  field(FLNK, "$(dtype):$(areapos):$(attribute)_calc")
}

record(calcout, "$(dtype):$(areapos):$(attribute)_calc") {
  field(INPA,  "$(dtype):$(areapos):$(port)b$(bit)")
  field(INPB, "$(plc):TABLE_9_SEG_1 CP")
  field(CALC, "B")
  field(OCAL, "A")
  field(DOPT, "Use OCAL")
  field(OOPT, "When Non-zero")
  field(OUT,  "$(dtype):$(areapos):$(attribute) PP")
}

record(bi, "$(dtype):$(areapos):$(attribute)") {
  field(DESC, "$(description)")
  field(ZNAM, "$(zname)")
  field(ONAM, "$(oname)")
  field(ZSV,  "$(zsv)")
  field(OSV,  "$(osv)")
  info(autosaveFields_pass0, "SEVR")
}
