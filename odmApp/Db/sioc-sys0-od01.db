record( bo, "ODM:SYS0:100:AlarmReset")
{
  field(OUT, "ODM:SYS0:100:AlarmResetFan1 PP")
  field(HIGH, 1)
  field(ZNAM,"Normal")
  field(ONAM,"Reset")
}

record(dfanout, "ODM:SYS0:100:AlarmResetFan1") {
  field(OUTA, "ODM:LI00:100:AlarmReset PP")
  field(OUTB, "ODM:LI01:100:AlarmReset PP")
  field(OUTC, "ODM:LI02:100:AlarmReset PP")
  field(OUTD, "ODM:LI03:100:AlarmReset PP")
  field(OUTE, "ODM:LI04:100:AlarmReset PP")
  field(OUTF, "ODM:LI05:100:AlarmReset PP")
  field(OUTG, "ODM:LI06:100:AlarmReset PP")
  field(OUTH, "ODM:SYS0:100:AlarmResetFan2 PP")
}

record(dfanout, "ODM:SYS0:100:AlarmResetFan2") {
  field(OUTA, "ODM:LI07:100:AlarmReset PP")
  field(OUTB, "ODM:LI08:100:AlarmReset PP")
  field(OUTC, "ODM:SYS0:OD02:SuprHrtbtAlmReset PP")
}

record( bo, "ODM:SYS0:100:AlarmMute")
{
  field(OUT, "ODM:SYS0:100:AlarmMuteFan1 PP")
  field(HIGH, 1)
  field(ZNAM,"Normal")
  field(ONAM,"Mute")

}

record(dfanout, "ODM:SYS0:100:AlarmMuteFan1") {
