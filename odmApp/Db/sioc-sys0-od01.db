record( bo, "ODM:SYS0:100:AlarmReset")
{
  field(OUT, "ODM:SYS0:100:AlarmResetFan1 PP")
  field(HIGH, 1)
  field(ZNAM,"Normal")
  field(ONAM,"Reset")
}

record(dfanout, "ODM:SYS0:100:AlarmResetFan1") {
  field(OUTA, "ODM:LI00:100:AlarmReset PP")
  field(OUTB, "ODM:LI01:100:AlarmReset PP")
  field(OUTC, "ODM:LI02:100:AlarmReset PP")
  field(OUTD, "ODM:LI03:100:AlarmReset PP")
  field(OUTE, "ODM:LI04:100:AlarmReset PP")
  field(OUTF, "ODM:LI05:100:AlarmReset PP")
  field(OUTG, "ODM:LI06:100:AlarmReset PP")
  field(OUTH, "ODM:SYS0:100:AlarmResetFan2 PP")
}

record(dfanout, "ODM:SYS0:100:AlarmResetFan2") {
  field(OUTA, "ODM:LI07:100:AlarmReset PP")
  field(OUTB, "ODM:LI08:100:AlarmReset PP")
  field(OUTC, "ODM:SYS0:OD02:SuprHrtbtAlmReset PP")
}

record( bo, "ODM:SYS0:100:AlarmMute")
{
  field(OUT, "ODM:SYS0:100:AlarmMuteFan1 PP")
  field(HIGH, 1)
  field(ZNAM,"Normal")
  field(ONAM,"Mute")

}

record(dfanout, "ODM:SYS0:100:AlarmMuteFan1") {
  field(OUTA, "ODM:LI00:100:AlarmMute PP")
  field(OUTB, "ODM:LI01:100:AlarmMute PP")
  field(OUTC, "ODM:LI02:100:AlarmMute PP")
  field(OUTD, "ODM:LI03:100:AlarmMute PP")
  field(OUTE, "ODM:LI04:100:AlarmMute PP")
  field(OUTF, "ODM:LI05:100:AlarmMute PP")
  field(OUTG, "ODM:LI06:100:AlarmMute PP")
  field(OUTH, "ODM:SYS0:100:AlarmMuteFan2 PP")
}

record(dfanout, "ODM:SYS0:100:AlarmMuteFan2") {
  field(OUTA, "ODM:LI07:100:AlarmMute PP")
  field(OUTB, "ODM:LI08:100:AlarmMute PP")
}

record(calcout, "ODM:SYS0:100:AHU:PpsBypassLogic"){
    field(DESC, "PPS Bypass logic calculation")
    field(INPA, "PPS:SYSW:1:ZoneEntryA CPP MSS")
    field(INPB, "ODM:LI00:100:AHU:FaultStatus CPP MSS")
    field(INPC, "ODM:LI00:100:Ahu:AlarmByp CPP MSS")
    field(INPD, "ODM:LI07:100:AHU:FaultStatus CPP MSS")
    field(INPE, "ODM:LI07:100:Ahu:AlarmByp CPP MSS")
    field(CALC, "(A && (B || C) && (D || E)) || !A ? 0 : 1")
    field(OUT, "ODM:SYS0:100:AHU:PpsBypassAlarm PP")
}

record(bi, "ODM:SYS0:100:AHU:PpsBypassAlarm"){
    field(DESC, "PPS Bypass Alarm")
    field(ZNAM, "NO_ALARM")
    field(ONAM, "ALARM")
    field(ZSV, "NO_ALARM")
    field(OSV, "MAJOR")
}


