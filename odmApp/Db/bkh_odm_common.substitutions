
file readwrite.db {
pattern
    {     P,     MOD,         PORT}
    {$(BKH), 3012_01, $(M)_3012_01}
}

file bkhAErr.db {
pattern
    {     P,     MOD,         PORT}
    {$(BKH), 3012_01, $(M)_3012_01}
}

# For bus coupler
file bk9000.db {
pattern
    {     P,      DPORT,        RPORT,        WPORT}
    {$(BKH), $(M)_DEBUG, $(M)_BK9000R, $(M)_BK9000W}
}

file asynRecord.db {
pattern
    {      P,    R, PORT, ADDR, IMAX, OMAX}
