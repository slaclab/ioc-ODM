record(calc, "$(dtype):$(areapos):OP_HOURS") {
  field(INPA, "$(dtype):$(areapos):OP_HRS_MSB CP")
  field(INPB, "$(dtype):$(areapos):OP_HRS_LSB CP")
  field(CALC, "(A << 8)+(B>>8)")
  info(autosaveFields_pass0, "VAL")
}

record(mbbi, "$(dtype):$(areapos):BASE_MODEL") {
  field(DTYP, "Raw Soft Channel")
  field(NOBT, "8")
  field(INP, "$(dtype):$(areapos):OP_HRS_LSB CP")
  field(ZRVL, "0x00")
  field(ONVL, "0x02")
  field(TWVL, "0x04")
  field(THVL, "0x03")
  field(FRVL, "0x20")
  field(FVVL, "0x22")
  field(SXVL, "0x24")
  field(SVVL, "0x23")
  field(EIVL, "0x50")
  field(NIVL, "0x51")
  field(TEVL, "0x52")
  field(ZRST, "PNOZ m1p")
  field(ONST, "PNOZ m0p")
  field(TWST, "PNOZ m2p")
  field(THST, "PNOZ m3p")
  field(FRST, "PNOZ m1p ETH")
  field(FVST, "PNOZ m0p ETH")
  field(SXST, "PNOZ m2p ETH")
  field(SVST, "PNOZ m3p ETH")
  field(EIST, "PNOZ mm0p")
  field(NIST, "PNOZ mm0.1p")
  field(TEST, "PNOZ mm0.2p")
}